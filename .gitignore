# Unity generated
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# IDE / tooling
.vscode/
.idea/
.vs/
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd

# OS
.DS_Store
Thumbs.db

# Crash reports
sysinfo.txt

# Unity package manager
.upmconfig.toml

# Generated by Unity performance-test and Meta XR build processors
Assets/Resources/PerformanceTestRunInfo.json*
Assets/Resources/PerformanceTestRunSettings.json*
Assets/StreamingAssets/RuntimeActionBindings.json*
.utmp/

# Python tooling cache
__pycache__/
__pycache__.meta
*.pyc

# Local agent configuration and credentials
/.agents/work/
/.agents/engineering-os
/.codex/
/.aws/
/.env
/.env.*
!/.env.example

# Unity captures, exported packages, and Android signing material
/[Cc]aptures/
/[Ss]creenshots/
/[Tt]est[Rr]esults/
/[Cc]rash[Rr]eports/
*.apk
*.aab
*.unitypackage
*.keystore
*.jks

# Generated IDE state and native build output
.vsconfig.local
*.slnx
*.opendb
*.VC.db
/Native/**/CMakeFiles/
/Native/**/CMakeCache.txt
/Native/**/cmake_install.cmake
/Native/**/compile_commands.json
/Native/**/build/

# Offline Editor-only cinematic exports
/CinematicRenders/

# Local browser review artifacts
/.playwright-mcp/

# Video and HDR frame media never belong in Git, wherever a tool writes them (renders, headset recordings)
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.exr
